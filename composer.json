{
  "name": "netbull/core-bundle",
  "description": "Symfony utility bundle: entity-reference and phone-number form types, three-query Doctrine paginator, spatial/range/phone DBAL types, JS route export and Twig helpers",
  "type": "symfony-bundle",
  "authors": [
    {
      "name": "Aleksandar Dimitrov",
      "email": "netbull2007@gmail.com"
    }
  ],
  "keywords": [
    "symfony",
    "bundle",
    "forms",
    "select2",
    "paginator",
    "doctrine",
    "spatial",
    "phone-number",
    "js-routing"
  ],
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "beberlei/doctrineextensions": "1.5.*",
    "doctrine/collections": "^2.1",
    "doctrine/dbal": "^3.7",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/orm": "^2.20|^3.0",
    "doctrine/persistence": "^3.1|^4.0",
    "giggsey/libphonenumber-for-php": "9.*",
    "symfony/config": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dependency-injection": "7.4.*",
    "symfony/dom-crawler": "7.4.*",
    "symfony/event-dispatcher": "7.4.*",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/intl": "7.4.*",
    "symfony/options-resolver": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "itamair/geophp": "^1.12",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12",
    "tecnickcom/tcpdf": "^6.11"
  },
  "suggest": {
    "itamair/geophp": "Required by the spatial DBAL types (geometry, linestring, multilinestring, multipolygon)",
    "tecnickcom/tcpdf": "Required by the PrintLabels utility (PDF label sheets)"
  },
  "autoload": {
    "psr-4": {
      "NetBull\\CoreBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NetBull\\CoreBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs-fix": "vendor/bin/php-cs-fixer fix",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "test": "vendor/bin/phpunit",
    "check": [
      "@cs-check",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
